{{define "content"}}
<section class="card">
  <h2>Filter overrides</h2>
  <p class="hint">Each saved scene filter in Stash becomes a section in your player. Drag to reorder, rename, or hide a section. Empty name keeps the Stash name.</p>
  {{if .FilterError}}<p class="warn-box">Could not load saved filters from Stash: {{.FilterError}}</p>{{end}}
  <table id="filters">
    <thead><tr><th></th><th>Show</th><th>Stash name</th><th>Name in player</th></tr></thead>
    <tbody id="rows">
    {{range .FilterRows}}
      <tr data-id="{{.ID}}">
        <td><span class="handle" draggable="true" title="Drag to reorder">≡</span></td>
        <td><input type="checkbox" class="enabled" {{if not .Disabled}}checked{{end}}></td>
        <td><span class="src">{{.SourceName}}</span> <code class="id">{{.ID}}</code></td>
        <td><input class="name" placeholder="{{.SourceName}}" value="{{if ne .Name .SourceName}}{{.Name}}{{end}}"></td>
      </tr>
    {{end}}
    </tbody>
  </table>
  <p class="row">
    <button type="button" id="save-filters" class="primary">Save</button>
    <button type="button" id="reset-filters">Reset to Stash order</button>
    <span class="msg" id="filters-msg"></span>
  </p>
</section>
{{end}}
