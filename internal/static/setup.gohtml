{{define "content"}}
<form id="setup" class="form" autocomplete="off">
  <h1>Setup</h1>

  <h2>Connection</h2>
  <label>Stash GraphQL address
    <input name="stash_graphql_url" type="url" required value="{{.Config.StashGraphQLUrl}}" placeholder="http://localhost:9999/graphql">
    <small>As reachable from where Stash-VR runs. Your headset must reach the same host for streams and covers.</small>
  </label>
  <label>API key
    <input name="stash_api_key" type="password" value="" placeholder="{{if .Config.StashApiKeySet}}set, leave blank to keep{{else}}paste the key from Stash, Settings, Security{{end}}">
    <small>Changing the Stash host needs the key again.</small>
  </label>
  <div class="row">
    <button type="button" id="test">Test connection</button>
    <span class="msg" id="test-msg"></span>
  </div>

  <h2>Players</h2>
  <label>Favorite tag
    <input name="favorite_tag" value="{{.Config.FavoriteTag}}">
    <small>Scenes with this Stash tag show as favorites in HereSphere, and the other way round. Leave empty to turn favorite sync off.</small>
  </label>
  <label>Hidden sort name
    <input name="exclude_sort_name" required value="{{.Config.ExcludeSortName}}">
    <small>Tags whose sort name equals this are hidden from players.</small>
  </label>
  <label class="check"><input name="generate_summary_ids" type="checkbox" {{if .Config.GenerateSummaryIds}}checked{{end}}> Generate summary ids for categorized tags</label>
  <label>Heatmap height in pixels
    <input name="heatmap_height_px" type="number" min="0" max="200" value="{{.Config.HeatmapHeightPx}}">
    <small>0 keeps the height Stash generates.</small>
  </label>
  <label>Funscript index
    <input name="funscript_index_path" value="{{.Config.FunscriptIndexPath}}" placeholder="/opt/stash/funscript_index.sqlite">
    <small>Optional. Path to the timestampTrade plugin's funscript_index.sqlite; scripts it lists for a scene are offered as alternates in HereSphere.</small>
  </label>
  <label>Scenes per smart section
    <input name="smart_section_size" type="number" min="10" max="500" value="{{.Config.SmartSectionSize}}">
    <small>Continue watching, Recently added, Random and the other computed sections show this many scenes.</small>
  </label>
  <label class="check"><input name="force_https" type="checkbox" {{if .Config.ForceHTTPS}}checked{{end}}> Always build https links (only if your proxy does not send X-Forwarded-Proto)</label>
  <label class="check"><input name="deovr_autoload" type="checkbox" {{if .Config.DeovrAutoload}}checked{{end}}> Send the DeoVR library when DeoVR's browser opens the front page</label>

  <h2>Video rules</h2>
  <p class="lead">Tags decide how a scene is shown. Rules apply top to bottom; a later rule overrides an earlier one. Profiles stored: {{len .Profiles}}. Tune a scene in HereSphere and save it there; it then shows up here and can back a rule.</p>
  <div class="rules" id="rules">
    {{range .VideoRules}}{{template "rule-row" ($.Row .)}}{{end}}
  </div>
  <template id="rule-template">{{template "rule-row" .EmptyRow}}</template>
  <div class="row">
    <button type="button" id="add-rule">Add rule</button>
    <button type="button" id="save-rules" class="primary">Save rules</button>
    <button type="button" id="reset-rules">Reset to defaults</button>
    <span class="msg" id="rules-msg"></span>
  </div>

  <h2>Server</h2>
  <label>Log level
    <select name="log_level">
      {{range .LogLevels}}<option value="{{.}}"{{if eq . $.Config.LogLevel}} selected{{end}}>{{.}}</option>{{end}}
    </select>
  </label>
  <label>Path prefix
    <input name="base_path" value="{{.Config.BasePath}}" placeholder="/stashvr">
    <small>Only when a reverse proxy serves Stash-VR under a sub-path and does not send X-Forwarded-Prefix.</small>
  </label>
  <label>Listening on
    <input value="{{.Config.ListenAddress}}" disabled>
    <small>Set with LISTEN_ADDRESS. Needs a restart.</small>
  </label>
  <label>Settings file
    <input value="{{.Config.ConfigPath}}" disabled>
  </label>

  <div class="row">
    <button type="submit" class="primary">Save changes</button>
    <span class="msg" id="save-msg"></span>
  </div>
</form>
{{end}}

{{/* rule-row renders one editable rule; the inputs carry classes, not
     names, so the settings form's read() leaves them alone. */}}
{{define "rule-row"}}{{$r := .Rule}}
      <div class="rule" data-rule>
        <div class="rule-head">
          <span class="handle" draggable="true" title="Drag to reorder" aria-label="Drag to reorder">⋮⋮</span>
          <input class="tag" value="{{$r.Tag}}" placeholder="Stash tag" aria-label="Tag">
          <button type="button" class="remove" aria-label="Remove rule">×</button>
        </div>
        <div class="rule-fields">
          <label class="field">Projection<select class="projection"><option value="">unchanged</option>{{range .Projections}}<option value="{{.}}"{{if eq . $r.Projection}} selected{{end}}>{{.}}</option>{{end}}</select></label>
          <label class="field">Stereo<select class="stereo"><option value="">unchanged</option>{{range .Stereos}}<option value="{{.}}"{{if eq . $r.Stereo}} selected{{end}}>{{.}}</option>{{end}}</select></label>
          <label class="field">Lens<select class="lens"><option value="">none</option>{{range .Lenses}}<option value="{{.}}"{{if eq . $r.Lens}} selected{{end}}>{{.}}</option>{{end}}</select></label>
          <label class="field">Field of view<input class="fov" type="number" min="0" max="360" step="1" value="{{if $r.Fov}}{{$r.Fov}}{{end}}" placeholder="unchanged"></label>
          <label class="field">Profile<select class="profile"><option value="">none</option>{{range .Profiles}}<option value="{{.ID}}"{{if eq .ID $r.Profile}} selected{{end}}>{{.ID}}{{if .Title}} {{.Title}}{{end}}</option>{{end}}</select></label>
          <label class="field check"><input class="passthrough" type="checkbox" {{if $r.Passthrough}}checked{{end}}> Passthrough</label>
        </div>
      </div>
{{end}}
