{{define "content"}}
<form id="setup" class="form" autocomplete="off">
  <h1>Setup</h1>

  <h2>Connection</h2>
  <label>Stash GraphQL address
    <input name="stash_graphql_url" type="url" required value="{{.Config.StashGraphQLUrl}}" placeholder="http://localhost:9999/graphql">
    <small>As reachable from where Stash-VR runs. Your headset must reach the same host for streams and covers.</small>
  </label>
  <label>API key
    <input name="stash_api_key" type="password" value="" placeholder="{{if .Config.StashApiKeySet}}set, leave blank to keep{{else}}paste the key from Stash, Settings, Security{{end}}">
    <small>Changing the Stash host needs the key again.</small>
  </label>
  <div class="row">
    <button type="button" id="test">Test connection</button>
    <span class="msg" id="test-msg"></span>
  </div>

  <h2>Players</h2>
  <label>Favorite tag
    <input name="favorite_tag" value="{{.Config.FavoriteTag}}">
    <small>Scenes with this Stash tag show as favorites in HereSphere, and the other way round. Leave empty to turn favorite sync off.</small>
  </label>
  <label>Hidden sort name
    <input name="exclude_sort_name" required value="{{.Config.ExcludeSortName}}">
    <small>Tags whose sort name equals this are hidden from players.</small>
  </label>
  <label class="check"><input name="generate_summary_ids" type="checkbox" {{if .Config.GenerateSummaryIds}}checked{{end}}> Generate summary ids for categorized tags</label>
  <label>Heatmap height in pixels
    <input name="heatmap_height_px" type="number" min="0" max="200" value="{{.Config.HeatmapHeightPx}}">
    <small>0 keeps the height Stash generates.</small>
  </label>
  <label>Funscript index
    <input name="funscript_index_path" value="{{.Config.FunscriptIndexPath}}" placeholder="/opt/stash/funscript_index.sqlite">
    <small>Optional. Path to the timestampTrade plugin's funscript_index.sqlite; scripts it lists for a scene are offered as alternates in HereSphere.</small>
  </label>
  <label>Scenes per smart section
    <input name="smart_section_size" type="number" min="10" max="500" value="{{.Config.SmartSectionSize}}">
    <small>Continue watching, Recently added, Random and the other computed sections show this many scenes.</small>
  </label>
  <label>Studio sections from N scenes
    <input name="auto_studio_min" type="number" min="0" max="10000" value="{{.Config.AutoStudioMin}}">
    <small>0 turns it off. Up to 50 of each, largest first.</small>
  </label>
  <label>Performer sections from N scenes
    <input name="auto_performer_min" type="number" min="0" max="10000" value="{{.Config.AutoPerformerMin}}">
    <small>0 turns it off. Up to 50 of each, largest first.</small>
  </label>
  <label class="check"><input name="force_https" type="checkbox" {{if .Config.ForceHTTPS}}checked{{end}}> Always build https links (only if your proxy does not send X-Forwarded-Proto)</label>
  <label class="check"><input name="deovr_autoload" type="checkbox" {{if .Config.DeovrAutoload}}checked{{end}}> Send the DeoVR library when DeoVR's browser opens the front page</label>
  <label class="check"><input name="performer_facets" type="checkbox" {{if .Config.PerformerFacets}}checked{{end}}> Performer facets (Country and Age tags in HereSphere)</label>
  <label class="check"><input name="date_lookup" type="checkbox" {{if .Config.DateLookup}}checked{{end}}> Look up missing release dates from your stash-boxes</label>
  <label class="check"><input name="date_writeback" type="checkbox" {{if .Config.DateWriteback}}checked{{end}}> Write found dates back to Stash</label>
  <p class="lead">Release dates: {{.DateStats.Found}} found, {{.DateStats.Missing}} missing, {{.DateStats.Unchecked}} unchecked. Scenes without a date in Stash are matched on the stash-boxes configured in Stash, one every few seconds; found dates feed the Age facet and the Released tag and are kept in dates.json next to the settings.</p>

  <h3>Cover badges</h3>
  <p class="lead">Labels drawn onto scene covers, so the headset shows them in the library grid.</p>
  <label class="check"><input name="cover_badge_quality" type="checkbox" {{if .Config.CoverBadges.Quality}}checked{{end}}> Quality: the vrQualityTags tier (8K, 7K, 6K HBR), else the file resolution</label>
  <label class="check"><input name="cover_badge_format" type="checkbox" {{if .Config.CoverBadges.Format}}checked{{end}}> Format: the projection from the video rules (180, 360, FISHEYE, FLAT 3D)</label>
  <label class="check"><input name="cover_badge_passthrough" type="checkbox" {{if .Config.CoverBadges.Passthrough}}checked{{end}}> Passthrough: AR on scenes with an alpha matte or a chroma key</label>

  <h2>Video rules</h2>
  <p class="lead">Tags decide how a scene is shown. Rules apply top to bottom; a later rule overrides an earlier one. Profiles stored: {{len .Profiles}}. Tune a scene in HereSphere and save it there; it then shows up here and can back a rule.</p>
  <div class="rules" id="rules">
    {{range .VideoRules}}{{template "rule-row" ($.Row .)}}{{end}}
  </div>
  <template id="rule-template">{{template "rule-row" .EmptyRow}}</template>
  <template id="default-rules">{{range .DefaultRows}}{{template "rule-row" .}}{{end}}</template>
  <template id="preset-rules">{{range .PresetRows}}{{template "rule-row" .Row}}{{end}}</template>
  <div class="row">
    <button type="button" id="add-rule">Add rule</button>
    <select id="add-preset" aria-label="Add a preset"><option value="">Add a preset</option>{{range $i, $p := .PresetRows}}<option value="{{$i}}">{{$p.Label}}</option>{{end}}</select>
    <button type="button" id="add-defaults" title="Appends the default rules whose tag is not in the table yet; existing rules are left as they are">Add missing default rules</button>
    <button type="button" id="save-rules" class="primary">Save rules</button>
    <button type="button" id="reset-rules">Reset to defaults</button>
    <span class="msg" id="rules-msg"></span>
  </div>

  <h3>Scene inspector</h3>
  <p class="lead">See which rules a scene matches, what they resolve to and where its HereSphere profile comes from. Uses the saved rules. Titles are searched among scenes a player has already loaded; an id always works.</p>
  <div class="row inspect-row">
    <input id="inspect-q" placeholder="Scene id or title" aria-label="Scene id or title">
    <button type="button" id="inspect">Inspect</button>
    <span class="msg" id="inspect-msg"></span>
  </div>
  <div id="inspect-out"></div>

  <details class="coverage" id="coverage-panel">
    <summary>Format coverage</summary>
    <p class="lead">Scene counts for the tags the vrQualityTags plugin manages, and VR-shaped scenes (at least 3840 wide, about 2:1 or 1:1) that have no projection tag. Counts link to the scene list in Stash. Asks Stash on demand; results are reused for a minute.</p>
    <div class="row">
      <button type="button" id="coverage">Check format coverage</button>
      <span class="msg" id="coverage-msg"></span>
    </div>
    <div id="coverage-out"></div>
  </details>

  <h2>Server</h2>
  <label>Log level
    <select name="log_level">
      {{range .LogLevels}}<option value="{{.}}"{{if eq . $.Config.LogLevel}} selected{{end}}>{{.}}</option>{{end}}
    </select>
  </label>
  <label>Path prefix
    <input name="base_path" value="{{.Config.BasePath}}" placeholder="/stashvr">
    <small>Only when a reverse proxy serves Stash-VR under a sub-path and does not send X-Forwarded-Prefix.</small>
  </label>
  <label>Listening on
    <input value="{{.Config.ListenAddress}}" disabled>
    <small>Set with LISTEN_ADDRESS. Needs a restart.</small>
  </label>
  <label>Settings file
    <input value="{{.Config.ConfigPath}}" disabled>
  </label>

  <div class="row">
    <button type="submit" class="primary">Save changes</button>
    <span class="msg" id="save-msg"></span>
  </div>
</form>
{{end}}

{{/* rule-row renders one editable rule; the inputs carry classes, not
     names, so the settings form's read() leaves them alone. */}}
{{define "rule-row"}}{{$r := .Rule}}
      <div class="rule" data-rule>
        <div class="rule-head">
          <span class="handle" draggable="true" title="Drag to reorder" aria-label="Drag to reorder">⋮⋮</span>
          <input class="tag" value="{{$r.Tag}}" placeholder="Stash tag" aria-label="Tag">
          <button type="button" class="remove" aria-label="Remove rule">×</button>
        </div>
        <div class="rule-fields">
          <label class="field">Projection<select class="projection"><option value="">unchanged</option>{{range .Projections}}<option value="{{.}}"{{if eq . $r.Projection}} selected{{end}}>{{.}}</option>{{end}}</select></label>
          <label class="field">Stereo<select class="stereo"><option value="">unchanged</option>{{range .Stereos}}<option value="{{.}}"{{if eq . $r.Stereo}} selected{{end}}>{{.}}</option>{{end}}</select></label>
          <label class="field">Lens<select class="lens"><option value="">none</option>{{range .Lenses}}<option value="{{.}}"{{if eq . $r.Lens}} selected{{end}}>{{.}}</option>{{end}}</select></label>
          <label class="field">Field of view<input class="fov" type="number" min="0" max="360" step="1" value="{{if $r.Fov}}{{$r.Fov}}{{end}}" placeholder="unchanged"></label>
          <label class="field">Profile<select class="profile"><option value="">none</option>{{range .Profiles}}<option value="{{.ID}}"{{if eq .ID $r.Profile}} selected{{end}}>{{.ID}}{{if .Title}} {{.Title}}{{end}}</option>{{end}}</select></label>
          {{$es := .Flag $r.EyeSwap}}<label class="field">Eye swap<select class="eye-swap"><option value="">unchanged</option><option value="on"{{if eq $es "on"}} selected{{end}}>on</option><option value="off"{{if eq $es "off"}} selected{{end}}>off</option></select></label>
          {{$fm := .Flag $r.ForceMono}}<label class="field">Force mono<select class="force-mono"><option value="">unchanged</option><option value="on"{{if eq $fm "on"}} selected{{end}}>on</option><option value="off"{{if eq $fm "off"}} selected{{end}}>off</option></select></label>
          <label class="field check"><input class="passthrough" type="checkbox" {{if $r.Passthrough}}checked{{end}}> Passthrough</label>
        </div>
        <details class="rule-screen"{{if .ScreenOpen}} open{{end}}>
          <summary>Screen and background</summary>
          <p class="hint">Values use HereSphere's own units. The easiest way to get them right is to adjust a scene in HereSphere, save it, then copy from that saved profile. Blank fields stay unchanged.</p>
          <div class="rule-fields geometry">
            {{range .Geometry}}<label class="field">{{.Label}}<input class="geom" data-key="{{.Key}}" type="number" step="any" value="{{.Value}}" placeholder="unchanged"></label>
            {{end}}<label class="field">Background<select class="background"><option value="">unchanged</option><option value="global"{{if eq $r.Background "global"}} selected{{end}}>global setting</option><option value="color"{{if eq $r.Background "color"}} selected{{end}}>color</option><option value="passthrough"{{if eq $r.Background "passthrough"}} selected{{end}}>passthrough</option></select></label>
            <label class="field">Background color<input class="background-color" type="color" value="{{.BackgroundColor}}" aria-label="Background color, used with the color background"></label>
            <label class="field">Mask<select class="mask"><option value="">unchanged</option><option value="none"{{if eq $r.Mask "none"}} selected{{end}}>none</option><option value="alpha"{{if eq $r.Mask "alpha"}} selected{{end}}>alpha packed</option><option value="chroma"{{if eq $r.Mask "chroma"}} selected{{end}}>chroma key</option></select></label>
          </div>
          <div class="row copy-row">
            <select class="copy-profile" aria-label="Copy from a saved profile"{{if not .Profiles}} disabled{{end}}><option value="">Copy from a saved profile</option>{{range .Profiles}}<option value="{{.ID}}">{{.ID}}{{if .Title}} {{.Title}}{{end}}</option>{{end}}</select>
            <span class="msg"></span>
          </div>
        </details>
      </div>
{{end}}
