{{define "layout"}}<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.Title}} - Stash-VR</title>
  <link rel="icon" href="{{.Base}}/icon.png" type="image/png">
  <link rel="stylesheet" href="{{.Base}}/app.css">
</head>
<body data-base="{{.Base}}">
<header class="bar">
  <a class="brand" href="{{.Base}}/"><img src="{{.Base}}/icon.png" alt="">Stash-VR</a>
  <nav>
    <a href="{{.Base}}/"{{if eq .Active "launch"}} aria-current="page"{{end}}>Players</a>
    <a href="{{.Base}}/setup"{{if eq .Active "setup"}} aria-current="page"{{end}}>Setup</a>
    <a href="{{.Base}}/sections"{{if eq .Active "sections"}} aria-current="page"{{end}}>Sections</a>
    <a href="{{.Base}}/log"{{if eq .Active "log"}} aria-current="page"{{end}}>Log</a>
  </nav>
</header>
<main>
{{template "content" .}}
</main>
<footer>Stash-VR {{.Version}}</footer>
<script src="{{.Base}}/app.js"></script>
</body>
</html>{{end}}
